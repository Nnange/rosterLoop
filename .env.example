# RosterLoop Environment Configuration
# Copy this file to /home/akweh/Documents/rosterloopEnv/.env on the server
# and fill in the actual values

SPRING_PROFILE=prod

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/households
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password_here

# Email (Gmail SMTP)
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password_here
